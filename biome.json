{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "stories/**",
      ".storybook/**",
      "*.js",
      "*.cjs",
      "biome.json",
      "tsconfig.json",
      ".stylelintrc.json",
      "!**/*.svg"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 90,
    "lineEnding": "lf",
    "bracketSpacing": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "none",
      "bracketSameLine": true,
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "useJsxKeyInIterable": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType"
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noImplicitAnyLet": "warn",
        "noTsIgnore": {
          "level": "warn",
          "fix": "none"
        }
      },
      "a11y": {
        "noAutofocus": "warn",
        "noStaticElementInteractions": "warn",
        "noSvgWithoutTitle": "off",
        "useAltText": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useSemanticElements": "warn"
      }
    }
  }
}
