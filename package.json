{
  "name": "@perawallet/react-ui-toolkit",
  "version": "2.0.0",
  "description": "Pera Wallet's React based UI toolkit. Fork of Studio Bakers' @hipo/react-ui-toolkit.",
  "license": "MIT",
  "author": "",
  "homepage": "https://github.com/perawallet/react-ui-toolkit#readme",
  "bugs": {
    "url": "https://github.com/perawallet/react-ui-toolkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perawallet/react-ui-toolkit.git"
  },
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsdown --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsdown && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o ./public",
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch",
    "oxlint": "oxlint",
    "oxlint:fix": "oxlint --fix",
    "format": "oxfmt \"**/*.{ts,tsx,js,cjs,mts,json}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx,js,cjs,mts,json}\"",
    "stylelint": "stylelint \"src/**/*.{css,scss}\" \"stories/**/*.scss\"",
    "stylelint:fix": "npm run stylelint -- --fix",
    "lint": "npm run oxlint && npm run format:check && npm run stylelint",
    "lint:fix": "npm run oxlint:fix && npm run format && npm run stylelint:fix",
    "check-package-updates": "npx npm-check-updates",
    "prepare": "husky || true && npm run build"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "ui",
    "react"
  ],
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "stories/**/*.{ts,tsx}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "**/*.scss": [
      "stylelint --fix"
    ]
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-links": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@svgr/rollup": "8.1.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@tsdown/css": "0.23.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "axe-core": "4.13.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.5.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sass": "1.104.0",
    "storybook": "10.6.0",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.1",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "classnames": "2.5.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "react-textarea-autosize": "8.5.9",
    "uuid": "11.1.1"
  },
  "peerDependencies": {
    "react": "^17.0.2 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.2 || ^18.0.0 || ^19.0.0"
  }
}
