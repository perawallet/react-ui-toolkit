{
  "name": "@hipo/react-ui-toolkit",
  "version": "2.0.0",
  "description": "Bakers Studio's React based UI toolkit.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rollup -c",
    "test": "jest",
    "test:watch": "npm t -- --watch",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o ./public",
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch",
    "biome": "biome check .",
    "biome:fix": "biome check --write .",
    "format": "biome format --write .",
    "stylelint": "stylelint \"src/**/*.{css,scss}\" \"stories/**/*.scss\"",
    "stylelint:fix": "npm run stylelint -- --fix",
    "lint": "npm run biome && npm run stylelint",
    "lint:fix": "npm run biome:fix && npm run stylelint:fix",
    "check-package-updates": "npx npm-check-updates",
    "prepare": "husky || true && npm run build"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "ui",
    "react"
  ],
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "stories/**/*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "**/*.scss": [
      "stylelint --fix"
    ]
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@rollup/plugin-terser": "1.0.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-links": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@svgr/rollup": "8.1.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "30.0.0",
    "@types/jest-axe": "3.5.9",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "axe-core": "4.13.0",
    "husky": "9.1.7",
    "jest": "30.5.1",
    "jest-axe": "11.0.0",
    "jest-environment-jsdom": "30.5.1",
    "lint-staged": "17.5.0",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rollup": "4.63.1",
    "rollup-plugin-postcss": "4.0.2",
    "rollup-plugin-typescript2": "0.37.0",
    "sass": "1.104.0",
    "storybook": "10.6.0",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.1",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-svgr": "5.2.0"
  },
  "dependencies": {
    "classnames": "2.5.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "react-textarea-autosize": "8.5.9",
    "uuid": "11.1.1"
  },
  "peerDependencies": {
    "react": "^17.0.2 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.2 || ^18.0.0 || ^19.0.0"
  }
}
